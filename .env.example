TAVILY_API_KEY=
OLLAMA_MODEL=llama3

# Native workspace commands read these settings from the process environment.
# agentguard init generates a token file when no bearer token is configured.
# AGENTGUARD_TOKEN_FILE=.agentguard/token
# AGENTGUARD_DB=.agentguard/workspace.db
# AGENTGUARD_API_TOKEN=
# AGENTGUARD_QUEUE_CAPACITY=100
# AGENTGUARD_ALLOW_MODEL=0
# AGENTGUARD_ALLOW_WEB=0
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Compose reads the published port and optionally an explicit web credential.
# AGENTGUARD_PORT=8000
# AGENTGUARD_TAVILY_KEY=
